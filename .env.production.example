APP_NAME="Gestion Dépense"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://depenses.example.com
APP_FORCE_HTTPS=true
TRUSTED_PROXIES=127.0.0.1

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_depense
DB_USERNAME=gestion_depense
DB_PASSWORD=

QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=crowpeter@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=crowpeter@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BACKUP_PATH=/var/backups/gestion-depense
BACKUP_RETENTION_DAYS=30
MYSQLDUMP_BINARY=/usr/bin/mysqldump
