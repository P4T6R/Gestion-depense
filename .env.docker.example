APP_NAME="Gestion Dépense"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_HTTP_PORT=8080
APP_FORCE_HTTPS=false
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gestion_depense
DB_USERNAME=gestion_depense
DB_PASSWORD=
MYSQL_DATABASE=gestion_depense
MYSQL_USER=gestion_depense
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=crowpeter@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=crowpeter@gmail.com
MAIL_FROM_NAME="Gestion Dépense"

BACKUP_PATH=/var/www/backups
BACKUP_RETENTION_DAYS=30
MYSQLDUMP_BINARY=/usr/bin/mysqldump
